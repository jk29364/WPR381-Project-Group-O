<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Login - AdvEvents</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="login-register-wrapper">
    <div class="login-register-card">

      <h3 class="text-center mb-1 fw-bold" style="color: #f5c518;">Welcome Back</h3>
      <p class="text-center text-muted small mb-4">Login to your account</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="error-message"><%= error %></div>
      <% } %>

      <form action="/login" method="POST">
        <div class="mb-3">
          <label class="form-label text-light">Email</label>
          <input type="email" name="email" class="form-control dark-input-field" placeholder="you@email.com" required/>
        </div>
        <div class="mb-3">
          <label class="form-label text-light">Password</label>
          <input type="password" name="password" class="form-control dark-input-field" placeholder="••••••••" required/>
        </div>
        <button type="submit" class="btn red-button w-100 mt-2">Login</button>
      </form>

      <p class="text-center text-muted small mt-3">
        Don't have an account? <a href="/register" style="color: #f5c518;">Register</a>
      </p>

    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
