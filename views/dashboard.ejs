<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Dashboard - AdvEvents</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="container my-5">

    <h2 class="fw-bold mb-1" style="color: #f5c518;">My Dashboard</h2>
    <p class="text-muted mb-4">Welcome back, <%= typeof user !== 'undefined' && user ? user.name : 'User' %></p>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="success-message"><%= success %></div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error-message"><%= error %></div>
    <% } %>

    <!-- BOOKING FORM - only shows when an event is selected -->
    <% if (typeof event !== 'undefined' && event) { %>
      <div class="card event-card mb-4 p-3">
        <h5 class="mb-1" style="color: #f5c518;">Book Tickets: <%= event.title %></h5>
        <p class="text-muted small mb-2">📍 <%= event.venue %> &nbsp;|&nbsp; 📅 <%= new Date(event.date).toDateString() %></p>
        <p class="small mb-3">Tickets available: <strong class="tickets-remaining-text"><%= event.ticketsRemaining %></strong></p>
        <form action="/bookings" method="POST">
          <input type="hidden" name="eventId" value="<%= event._id %>"/>
          <div class="row g-2">
            <div class="col-md-3">
              <input type="number" name="quantity" class="form-control dark-input-field" min="1" max="<%= event.ticketsRemaining %>" placeholder="Quantity" required/>
            </div>
            <div class="col-md-2">
              <button type="submit" class="btn red-button w-100">Book</button>
            </div>
          </div>
        </form>
      </div>
    <% } %>

    <!-- BOOKING HISTORY -->
    <h5 class="mb-3" style="color: #f5c518;">My Bookings</h5>

    <% if (typeof bookings !== 'undefined' && bookings.length > 0) { %>
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Event</th>
              <th>Date</th>
              <th>Venue</th>
              <th>Tickets</th>
              <th>Booked On</th>
            </tr>
          </thead>
          <tbody>
            <% bookings.forEach(function(booking) { %>
              <tr>
                <td><%= booking.eventId ? booking.eventId.title : 'N/A' %></td>
                <td><%= booking.eventId ? new Date(booking.eventId.date).toDateString() : '' %></td>
                <td><%= booking.eventId ? booking.eventId.venue : '' %></td>
                <td><%= booking.quantity %></td>
                <td><%= new Date(booking.bookingDate).toDateString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="text-muted">
        You haven't booked any events yet.
        <a href="/events" style="color: #f5c518;">Browse events</a>
      </p>
    <% } %>

  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>