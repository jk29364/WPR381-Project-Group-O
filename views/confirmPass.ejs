<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Register - AdvEvents</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="login-register-wrapper">
    <div class="login-register-card">

      <h3 class="text-center mb-1 fw-bold" style="color: #f5c518;">Confirm your Password</h3>
      <p class="text-center text-muted small mb-4">Just one last step...</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="error-message"><%= error %></div>
      <% } %>

      <form action="/register" method="POST">
        <!-- Hidden original values -->
        <input type="hidden" name="name" value="<%= name %>">
        <input type="hidden" name="email" value="<%= email %>">
        <input type="hidden" name="password" value="<%= password %>">

        <div class="mb-3">
          <label class="form-label text-light">Confirm Password</label>
          <input type="password" name="passconf" class="form-control dark-input-field" placeholder="••••••••" required/>
        </div>
        <button type="submit" class="btn red-button w-100 mt-2">Confirm</button>
      </form>

      <p class="text-center text-muted small mt-3">
        Mistyped? <a href="/register" style="color: #f5c518;">Go back</a>
      </p>

    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
