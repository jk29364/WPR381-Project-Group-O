<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Events - AdvEvents</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>

  <%- include('partials/navbar') %>

  <!-- PAGE HEADING -->
  <div class="container mt-5 mb-3">
    <h2 class="fw-bold mb-1" style="color: #f5c518;">All Events</h2>
    <p class="text-muted">Browse and book upcoming events</p>
  </div>

  <!-- FILTER BAR -->
  <div class="search-filter-bar">
    <div class="container">
      <form action="/events" method="GET" class="row g-2">
        <div class="col-md-5">
          <input
            type="text"
            name="search"
            class="form-control dark-input-field"
            placeholder="Search by name..."
            value="<%= typeof search !== 'undefined' ? search : '' %>"
          />
        </div>
        <div class="col-md-3">
          <select name="category" class="form-select dark-input-field">
            <option value="">All Categories</option>
            <option value="conference">Conference</option>
            <option value="festival">Festival</option>
            <option value="workshop">Workshop</option>
            <option value="private">Private</option>
          </select>
        </div>
        <div class="col-md-2">
          <input type="date" name="date" class="form-control dark-input-field"/>
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn red-button w-100">Filter</button>
        </div>
      </form>
    </div>
  </div>

  <!-- EVENTS GRID -->
  <div class="container my-4">
    <div class="row g-4">
      <% if (typeof events !== 'undefined' && events.length > 0) { %>
        <% events.forEach(function(event) { %>
          <div class="col-md-4">
            <div class="card event-card h-100">
              <div class="card-body d-flex flex-column">
                <span class="event-category-badge"><%= event.category %></span>
                <h5 class="card-title"><%= event.title %></h5>
                <p class="text-muted small mb-1">📍 <%= event.venue %></p>
                <p class="text-muted small mb-2">📅 <%= new Date(event.date).toDateString() %></p>
                <p class="small flex-grow-1"><%= event.description ? event.description.substring(0, 100) + '...' : '' %></p>
                <p class="tickets-remaining-text mb-2">Tickets left: <%= event.ticketsRemaining %></p>
                <a href="/events/<%= event._id %>" class="btn btn-sm red-outline-button mt-auto">Book Now</a>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p class="text-muted">No events found.</p>
      <% } %>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
